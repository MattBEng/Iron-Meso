# Cloudflare Pages headers — ensure the browser always re-checks the entry
# points so service-worker updates are discovered promptly.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# Long-cache the immutable assets (icons/fonts don't change without a new name)
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable
